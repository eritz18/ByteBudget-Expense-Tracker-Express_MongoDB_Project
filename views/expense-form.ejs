<%- include('partials/nav') %>
<div class="form-container">
    <h1><%= expense ? 'Edit expense' : 'Add expense' %></h1>
    <div class="card form-card">
        <form class="form-grid" method="POST" action="<%= expense ? '/expenses/' + expense._id : '/expenses' %>">
            <div class="field">
                <label for="description">Description</label>
                <input
                    id="description"
                    type="text"
                    name="description"
                    required
                    value="<%= expense ? expense.description : '' %>"
                >
            </div>
            <div class="field">
                <label for="amount">Amount (₱)</label>
                <input
                    id="amount"
                    type="number"
                    name="amount"
                    step="0.01"
                    min="0"
                    required
                    value="<%= expense ? expense.amount : '' %>"
                >
            </div>
            <div class="field">
                <label for="date">Date</label>
                <input
                    id="date"
                    type="date"
                    name="date"
                    required
                    value="<%= expense ? expense.date.toISOString().slice(0, 10) : new Date().toISOString().slice(0, 10) %>"
                >
            </div>
            <fieldset>
                <legend>Category</legend>
                <div class="cats">
                    <% categories.forEach((c, i) => { %>
                        <label class="cat">
                            <input
                                type="radio"
                                name="category"
                                value="<%= c %>"
                                required
                                <%= (expense ? expense.category === c : i === 0) ? 'checked' : '' %>
                            >
                            <span>
                                <i class="bi <%= icons[c] %>"></i>
                                <%= c %>
                            </span>
                        </label>
                    <% }) %>
                </div>
            </fieldset>
            <div class="field full">
                <label for="notes">Notes (optional)</label>
                <textarea
                    id="notes"
                    name="notes"
                    rows="3"
                ><%= expense ? expense.notes : '' %></textarea>
            </div>
            <div class="btn-row full">
                <button class="btn" type="submit">
                    <i class="bi bi-check-lg"></i>
                    Save expense
                </button>
                <a class="btn light" href="/expenses">
                    <i class="bi bi-x-lg"></i>
                    Cancel
                </a>
            </div>
        </form>
    </div>
</div>

<%- include('partials/footer') %>
