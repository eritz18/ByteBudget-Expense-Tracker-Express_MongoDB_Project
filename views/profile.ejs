<%- include('partials/nav') %>
<h1>My Profile</h1>

<div class="profile-grid">
  <div class="card">
    <h2><i class="bi bi-person-circle"></i>Personal Information</h2>
    <% if (profileError) { %><p class="error"><%= profileError %></p><% } %>
    <% if (profileSuccess) { %><p class="success"><%= profileSuccess %></p><% } %>
    <form method="POST" action="/profile">
      <div class="field">
        <label for="name">Name</label>
        <input id="name" type="text" name="name" required maxlength="50" value="<%= form.name %>">
      </div>
      <div class="field">
        <label for="username">Username</label>
        <input id="username" type="text" name="username" required maxlength="30" value="<%= form.username %>">
      </div>
      <div class="field">
        <label for="email">Email</label>
        <input id="email" type="email" name="email" required value="<%= form.email %>">
      </div>
      <button class="btn" type="submit"><i class="bi bi-check-lg"></i>Save Changes</button>
    </form>
  </div>

  <div class="card">
    <h2><i class="bi bi-key"></i>Change Password</h2>
    <% if (passwordError) { %><p class="error"><%= passwordError %></p><% } %>
    <% if (passwordSuccess) { %><p class="success"><%= passwordSuccess %></p><% } %>
    <form method="POST" action="/profile/change-password">
      <div class="field">
        <label for="currentPassword">Current Password</label>
        <input id="currentPassword" type="password" name="currentPassword" required autocomplete="current-password">
      </div>
      <div class="field">
        <label for="newPassword">New Password (at least 6 characters)</label>
        <input id="newPassword" type="password" name="newPassword" required minlength="6" autocomplete="new-password">
      </div>
      <div class="field">
        <label for="confirmNewPassword">Confirm New Password</label>
        <input id="confirmNewPassword" type="password" name="confirmNewPassword" required minlength="6" autocomplete="new-password">
      </div>
      <button class="btn" type="submit"><i class="bi bi-shield-lock"></i>Change Password</button>
    </form>
  </div>
</div>
<%- include('partials/footer') %>
